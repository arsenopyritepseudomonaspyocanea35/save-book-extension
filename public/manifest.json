{
  "manifest_version": 3,
  "name": "Save Book",
  "version": "0.1.0",
  "description": "Keep the logins, numbers and notes you need right next to the sites you need them on.",
  "minimum_chrome_version": "123",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save Book — toggle the card on this site",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
