{
  "name": "save-book-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build -c vite.content.config.ts && vite build -c vite.app.config.ts",
    "watch": "vite build -c vite.content.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "package": "bun run build && bun scripts/package.mjs"
  },
  "dependencies": {
    "@solid-primitives/i18n": "^2.2.1",
    "solid-js": "^1.9.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.0"
  }
}
